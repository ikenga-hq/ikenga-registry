            "promptCaching": false,
            "agenticTools": false,
            "mcp": false,
            "sessionResume": true
          },
          "onboarding": {
            "requiredVaultKeys": [
              "OPENROUTER_API_KEY"
            ],
            "requiredEnvVars": [],
            "authCommand": "openrouter login",
            "docsUrl": "https://openrouter.ai/docs"
          }
        }
